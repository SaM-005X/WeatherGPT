{
  "name": "weather-gpt-backend",
  "version": "1.0.0",
  "private": true,
  "description": "WeatherGPT AWS Serverless Backend",
  "scripts": {
    "bundle:lambda": "esbuild src/handlers/appsync.ts --bundle --platform=node --target=es2022 --format=cjs --sourcemap --outfile=dist/handlers/appsync.js",
    "build": "npm run bundle:lambda && tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^20.17.19",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
