# Supabase Configuration (Frontend - Safe public keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AWS AppSync Managed GraphQL API
NEXT_PUBLIC_APPSYNC_GRAPHQL_URL=https://your-api-id.appsync-api.your-region.amazonaws.com/graphql
NEXT_PUBLIC_APPSYNC_ENDPOINT=https://your-api-id.appsync-api.your-region.amazonaws.com/graphql
NEXT_PUBLIC_APPSYNC_API_KEY=da2-your-api-key-here

# Groq Cloud API Configuration (Weather Chatbot - Qwen 3.8 27B)
# If omitted or placeholder, the assistant operates in grounded deterministic meteorological fallback mode.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

